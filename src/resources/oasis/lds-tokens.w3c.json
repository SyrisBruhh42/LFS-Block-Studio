{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "Lewis Design System (LDS) Canonical W3C Design Tokens",
    "version": "1.0.0",
    "task_id": "X10",
    "authority": "DA-06",
    "default_pack": "evergreen-dark",
    "theme_packs": [
      "evergreen-dark",
      "evergreen-light",
      "high-contrast",
      "calm"
    ],
    "conflict_resolutions": {
      "LDS-CONFLICT-01": {
        "title": "Divergent Dark Background Canvas Tokens across Web, GTK3, Android Compose, and Weightless",
        "status": "RESOLVED",
        "canonical_tokens": {
          "evergreen-dark.color.bg.canvas": "#0F1714",
          "evergreen-dark.color.bg.surface": "#141F1B",
          "calm.color.bg.canvas": "#0B1113",
          "calm.color.bg.surface": "#101719"
        },
        "note": "Unifies chrome background roles across Web, GTK3, Android Compose, and Weightless while keeping game world canvases independent."
      },
      "LDS-CONFLICT-02": {
        "title": "Divergent Primary Brand / Accent Green Tokens across Stacks",
        "status": "RESOLVED",
        "canonical_tokens": {
          "evergreen-dark.color.accent.primary": "#6EE7B7",
          "evergreen-light.color.accent.primary": "#165B36",
          "high-contrast.color.accent.primary": "#00FFFF",
          "calm.color.accent.primary": "#B8E4CF"
        },
        "note": "Semantic color.accent.* and color.status.* tokens verified against WCAG 2.2 AA (>=4.5:1) and High-Contrast AAA (>=7.0:1)."
      },
      "LDS-CONFLICT-03": {
        "title": "43 Hardcoded Hex Colors in aegis_hub.py and 214 Raw Cairo RGB/RGBA Calls in lfs_pet.py",
        "status": "RESOLVED",
        "canonical_tokens": {
          "gtk3_css_output": "core/companion/clients/linux/lds_tokens.css",
          "cairo_python_output": "core/companion/clients/linux/lds_tokens.py"
        },
        "note": "Deterministic GTK3 CSS and normalized float RGBA Cairo palette generated from W3C tokens."
      },
      "LDS-CONFLICT-04": {
        "title": "High-Contrast Focus Ring & Border Token Mismatch",
        "status": "RESOLVED",
        "canonical_tokens": {
          "high-contrast.color.border.focus": "#00FFFF",
          "high-contrast.color.border.default": "#FFFFFF",
          "high-contrast.focus.ring_width": "3px"
        },
        "note": "Standardizes High Contrast pack tokens (>=7:1 text contrast, 3px solid focus ring, zero transparency)."
      },
      "LDS-CONFLICT-05": {
        "title": "Godot 4 Game Capsules Lack Shared Menu Theme Resource (.tres)",
        "status": "RESOLVED",
        "canonical_tokens": {
          "godot_tres_output": "core/lds/aegis_lds_theme.tres"
        },
        "note": "Generates shared Godot 4.3 Theme resource for pause/settings/launcher chrome while preserving game-world shaders."
      },
      "LDS-CONFLICT-06": {
        "title": "U1 Sanctuary Offline HTML and NetPulse Use Standalone Inline Hex Colors Outside LDS Tokens",
        "status": "RESOLVED",
        "canonical_tokens": {
          "u1_css_output": "core/anchor-edge/infra/hetzner-anchor-staging/lds-tokens.css"
        },
        "note": "Compiles offline-capable LDS stylesheet for U1 Sanctuary and NetPulse surfaces."
      }
    }
  },
